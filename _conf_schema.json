{
  "default_kb_id": {
    "type": "string",
    "default": "default",
    "description": "兜底知识库 ID（默认聚合检索集合为空时，rag_search 工具与自动图片检索使用它；留空则禁用兜底）",
    "group": "general"
  },
  "default_kb_ids": {
    "type": "list",
    "default": [],
    "description": "默认聚合检索知识库集合（rag_search 工具与自动图片检索的目标；知识库管理页勾选维护，新建自动加入、删除自动移除。此处可手动修复：多个 ID 用英文逗号分隔）",
    "group": "general"
  },
  "qdrant_url": {
    "type": "string",
    "default": "http://127.0.0.1:6333",
    "description": "Qdrant 服务地址",
    "group": "qdrant"
  },
  "qdrant_api_key": {
    "type": "string",
    "default": "",
    "description": "Qdrant API Key（本地开发可留空）",
    "group": "qdrant"
  },
  "embedding_api_base": {
    "type": "string",
    "default": "https://integrate.api.nvidia.com/v1",
    "description": "Embedding API Base URL（OpenAI 兼容）",
    "group": "embedding"
  },
  "embedding_api_key": {
    "type": "string",
    "default": "",
    "description": "Embedding API Key",
    "group": "embedding"
  },
  "embedding_model": {
    "type": "string",
    "default": "nvidia/llama-nemotron-embed-vl-1b-v2",
    "description": "Embedding 模型名称",
    "group": "embedding"
  },
  "embedding_dimension": {
    "type": "int",
    "default": 2048,
    "description": "Embedding 向量维度",
    "group": "embedding"
  },
  "embedding_batch_size": {
    "type": "int",
    "default": 32,
    "description": "Embedding 批量大小",
    "group": "embedding"
  },
  "embedding_concurrency": {
    "type": "int",
    "default": 4,
    "description": "Embedding 并发数",
    "group": "embedding"
  },
  "embedding_input_type": {
    "type": "string",
    "default": "passage",
    "description": "索引时的 input_type（NVIDIA 非对称模型要求）",
    "group": "embedding"
  },
  "rerank_enabled": {
    "type": "bool",
    "default": true,
    "description": "是否启用 Reranker",
    "group": "rerank"
  },
  "rerank_api_base": {
    "type": "string",
    "default": "https://api.siliconflow.cn/v1",
    "description": "Rerank API Base URL",
    "group": "rerank"
  },
  "rerank_api_key": {
    "type": "string",
    "default": "",
    "description": "Rerank API Key",
    "group": "rerank"
  },
  "rerank_model": {
    "type": "string",
    "default": "BAAI/bge-reranker-v2-m3",
    "description": "Rerank 模型名称",
    "group": "rerank"
  },
  "top_k": {
    "type": "int",
    "default": 30,
    "description": "向量检索候选数 Top-K",
    "group": "retrieval"
  },
  "top_n": {
    "type": "int",
    "default": 6,
    "description": "最终返回数 Top-N",
    "group": "retrieval"
  },
  "rerank_pool_size": {
    "type": "int",
    "default": 60,
    "description": "重排序候选池上限。多库聚合检索时每个库贡献 top_k 条进候选池，总池不超过此值（防止候选过多导致 Rerank 调用过大）",
    "group": "retrieval"
  },
  "ingest_concurrency": {
    "type": "int",
    "default": 2,
    "description": "同时进行索引操作的最大并发数（上传多个文件时后端排队执行，可调大以加速批量导入）",
    "group": "general"
  },
  "chunk_separator": {
    "type": "string",
    "default": "\n\n",
    "description": "文本分块分隔符",
    "group": "chunking"
  },
  "chunk_size": {
    "type": "int",
    "default": 800,
    "description": "分块最大字符数",
    "group": "chunking"
  },
  "chunk_overlap": {
    "type": "int",
    "default": 100,
    "description": "分块重叠字符数",
    "group": "chunking"
  },
  "image_enabled": {
    "type": "bool",
    "default": false,
    "description": "是否启用图片向量检索",
    "group": "image"
  },
  "image_api_base": {
    "type": "string",
    "default": "https://integrate.api.nvidia.com/v1",
    "description": "图片 Embedding API Base URL（留空则复用文本配置）",
    "group": "image"
  },
  "image_api_key": {
    "type": "string",
    "default": "",
    "description": "图片 Embedding API Key（留空则复用文本配置）",
    "group": "image"
  },
  "image_model": {
    "type": "string",
    "default": "nvidia/llama-nemotron-embed-vl-1b-v2",
    "description": "图片 Embedding 模型（需支持图片输入）",
    "group": "image"
  },
  "image_dimension": {
    "type": "int",
    "default": 2048,
    "description": "图片向量维度",
    "group": "image"
  },
  "image_search_always": {
    "type": "bool",
    "default": false,
    "description": "普通文本查询是否总是同时检索图片向量",
    "group": "image"
  },
  "image_auto_search": {
    "type": "bool",
    "default": true,
    "description": "消息带图时自动对图片做向量检索，并将结果注入 LLM 上下文（不干扰原生图像转述/直通）",
    "group": "image"
  },
  "image_min_score": {
    "type": "float",
    "default": 0.0,
    "description": "自动图片检索的最低相似度阈值（0~1，0 表示不过滤；知识库较小易误命中时建议调高，如 0.3）",
    "group": "image"
  }
}
