{
  "default_kb_id": {
    "type": "string",
    "default": "default",
    "description": "默认知识库 ID"
  },
  "qdrant_url": {
    "type": "string",
    "default": "http://127.0.0.1:6333",
    "description": "Qdrant 服务地址"
  },
  "qdrant_api_key": {
    "type": "string",
    "default": "",
    "description": "Qdrant API Key（本地开发可留空）"
  },
  "embedding_api_base": {
    "type": "string",
    "default": "https://integrate.api.nvidia.com/v1",
    "description": "Embedding API Base URL（OpenAI 兼容）"
  },
  "embedding_api_key": {
    "type": "string",
    "default": "",
    "description": "Embedding API Key"
  },
  "embedding_model": {
    "type": "string",
    "default": "nvidia/llama-nemotron-embed-vl-1b-v2",
    "description": "Embedding 模型名称"
  },
  "embedding_dimension": {
    "type": "int",
    "default": 2048,
    "description": "Embedding 向量维度"
  },
  "embedding_batch_size": {
    "type": "int",
    "default": 32,
    "description": "Embedding 批量大小"
  },
  "embedding_concurrency": {
    "type": "int",
    "default": 4,
    "description": "Embedding 并发数"
  },
  "embedding_input_type": {
    "type": "string",
    "default": "passage",
    "description": "索引时的 input_type（NVIDIA 非对称模型要求）"
  },
  "rerank_enabled": {
    "type": "bool",
    "default": true,
    "description": "是否启用 Reranker"
  },
  "rerank_api_base": {
    "type": "string",
    "default": "https://api.siliconflow.cn/v1",
    "description": "Rerank API Base URL"
  },
  "rerank_api_key": {
    "type": "string",
    "default": "",
    "description": "Rerank API Key"
  },
  "rerank_model": {
    "type": "string",
    "default": "BAAI/bge-reranker-v2-m3",
    "description": "Rerank 模型名称"
  },
  "top_k": {
    "type": "int",
    "default": 30,
    "description": "向量检索候选数 Top-K"
  },
  "top_n": {
    "type": "int",
    "default": 6,
    "description": "最终返回数 Top-N"
  },
  "chunk_separator": {
    "type": "string",
    "default": "\n\n",
    "description": "文本分块分隔符"
  },
  "chunk_size": {
    "type": "int",
    "default": 800,
    "description": "分块最大字符数"
  },
  "chunk_overlap": {
    "type": "int",
    "default": 100,
    "description": "分块重叠字符数"
  },
  "image_enabled": {
    "type": "bool",
    "default": false,
    "description": "是否启用图片向量检索"
  },
  "image_api_base": {
    "type": "string",
    "default": "https://integrate.api.nvidia.com/v1",
    "description": "图片 Embedding API Base URL（留空则复用文本配置）"
  },
  "image_api_key": {
    "type": "string",
    "default": "",
    "description": "图片 Embedding API Key（留空则复用文本配置）"
  },
  "image_model": {
    "type": "string",
    "default": "nvidia/llama-nemotron-embed-vl-1b-v2",
    "description": "图片 Embedding 模型（需支持图片输入）"
  },
  "image_dimension": {
    "type": "int",
    "default": 2048,
    "description": "图片向量维度"
  },
  "image_search_always": {
    "type": "bool",
    "default": false,
    "description": "普通文本查询是否总是同时检索图片向量"
  }
}
